# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# LOCALNET PHASE 2 — POSTGRESQL + POSTGIS & AWS CONFIGURATION (PLACEHOLDERS)
# ============================================================================
NODE_ENV="development"
PORT="3000"

# Database Role Connections (Never use postgres superuser for application runtime)
# 1. Runtime Application Role (NOSUPERUSER, no DDL permissions)
DATABASE_URL="postgresql://localnet_app:CHANGE_ME_APP_PASSWORD@localhost:5432/localnet"
# 2. Schema Migration Role (Used only by npm run db:migrate)
MIGRATOR_DATABASE_URL="postgresql://localnet_migrator:CHANGE_ME_MIGRATOR_PASSWORD@localhost:5432/localnet"
# 3. Read-Only Analytics Role
READONLY_DATABASE_URL="postgresql://localnet_readonly:CHANGE_ME_READONLY_PASSWORD@localhost:5432/localnet"
# 4. Automated Integration Test Role
TEST_DATABASE_URL="postgresql://localnet_test:CHANGE_ME_TEST_PASSWORD@localhost:5432/localnet_test"

# Firebase Authentication (Client & Server)
VITE_FIREBASE_API_KEY="AIzaSyACX8sWQWhow_ZnPj0GQ7SE3nZxafCCaF0"
VITE_FIREBASE_AUTH_DOMAIN="localnet-8fe40.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="localnet-8fe40"
VITE_FIREBASE_STORAGE_BUCKET="localnet-8fe40.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="268165556142"
VITE_FIREBASE_APP_ID="1:268165556142:web:01d1b467569b94b2b28a3f"
FIREBASE_PROJECT_ID="localnet-8fe40"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@localnet-8fe40.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_PLACEHOLDER\n-----END PRIVATE KEY-----\n"
# Set to "true" ONLY in local development when Firebase credentials are not configured
ALLOW_DEV_TEST_AUTH="true"
ALLOW_DEV_CITY_PRESETS="true"

# Media Storage & Delivery (Dual-mode: Local disk outside web root in dev; S3 + CloudFront in prod)
STORAGE_PROVIDER="local" # "local" | "s3"
LOCAL_UPLOAD_DIR="uploads"
PUBLIC_APP_URL="http://localhost:3000"

# AWS S3 / CloudFront Configuration (Used when STORAGE_PROVIDER="s3")
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="localnet-media-ap-south-1-dev"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
AWS_ENDPOINT="" # Optional custom endpoint for MinIO, LocalStack, Cloudflare R2
CLOUDFRONT_URL="https://d111111abcdef8.cloudfront.net"
S3_FORCE_PATH_STYLE="false"

# Client Upload Limits
MAX_IMAGE_SIZE_MB="10"
MAX_VIDEO_SIZE_MB="100"
MAX_VIDEO_DURATION_SECONDS="120"


